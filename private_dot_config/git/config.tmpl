[alias]
	cm = "commit"
	co = "checkout"
	pu = "push"

[core]
	editor = "nvim"


[diff]
	tool = "nvimdiff"

[difftool "nvimdiff"]
	cmd = "nvim -d $LOCAL $REMOTE -c \"$wincmd w\" -c \"wincmd L\""


[init]
	defaultBranch = "main"

[merge]
	tool = "nvimdiff"

[mergetool "nvimdiff"]
	cmd = "nvim -d $LOCAL $MERGED $REMOTE -c \"wincmd l\" -c \"wincmd h\""

[user]
# Identity is machine data, not a secret lookup: this lets chezmoi render before
# 1Password is installed or signed in. Set name/email in chezmoi.toml.
name = {{ dig "name" (env "USER") . | quote }}
{{- with (dig "email" "" .) }}
email = {{ . | quote }}
{{- end }}

{{- if and (eq (dig "profile" "server" .) "workstation") (eq .chezmoi.os "darwin") }}
# Default GPG/SSH signing configuration for a trusted macOS workstation
[gpg]
	format = ssh

[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
	gpgsign = true

# GitHub repositories - use Ed25519 key
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
	path = ~/.config/git/config-github

[includeIf "hasconfig:remote.*.url:https://github.com/**"]
	path = ~/.config/git/config-github

# Azure DevOps repositories - use RSA key
[includeIf "hasconfig:remote.*.url:git@ssh.dev.azure.com:*/**"]
	path = ~/.config/git/config-azure

[includeIf "hasconfig:remote.*.url:https://dev.azure.com/**"]
	path = ~/.config/git/config-azure
{{- end }}
