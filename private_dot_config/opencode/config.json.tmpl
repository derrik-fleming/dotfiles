{
  "$schema": "https://opencode.ai/config.json",
  "theme": "rose-pine-moon-custom",
  "autoshare": false,
  "share": "disabled",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask"
  },
  "keybinds": {},
  "autoupdate": true,
  "mcp": {
    "dart": {
      "type": "local",
      "command": [
        "dart",
        "mcp-server"
      ],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--rm",
        "-i",
        "--mount",
        "type=bind,src=/Users/derrik.fleming/repos,dst=/projects/repos",
        "mcp/git"
      ],
      "enabled": true
    }{{- if eq .context "work" }},
    "azure-devops": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--rm",
        "-i",
        "-e",
        "ADO_ORG={{ onepasswordRead "op://Work/work-identity/Identification/company" | lower }}",
        "mcp/azure-devops"
      ],
      "enabled": true
    }{{- end }}
  },
  "formatter": {
    "javascript": {
      "command": [
        "prettier",
        "--write",
        "{file}"
      ]
    },
    "typescript": {
      "command": [
        "prettier",
        "--write",
        "{file}"
      ]
    },
    "python": {
      "command": [
        "black",
        "{file}"
      ]
    },
    "go": {
      "command": [
        "gofmt",
        "-w",
        "{file}"
      ]
    },
    "rust": {
      "command": [
        "rustfmt",
        "{file}"
      ]
    }
  },
  "instructions": [
    "~/.config/opencode/dev-rules.md"
  ],
  "lsp": {
    "dart": {
      "command": [
        "dart",
        "language-server",
        "--protocol=lsp"
      ],
      "extensions": [
        ".dart"
      ],
      "initialization": {
        "onlyAnalyzeProjectsWithOpenFiles": true
      }
    },
    "lua_ls": {
      "command": [
        "lua-language-server"
      ],
      "extensions": [
        ".lua"
      ]
    },
    "sourcekit": {
      "command": [
        "sourcekit-lsp"
      ],
      "extensions": [
        ".swift"
      ]
    },
    "phpactor": {
      "command": [
        "phpactor",
        "language-server"
      ],
      "extensions": [
        ".php"
      ]
    },
    "harper_ls": {
      "command": [
        "harper-ls",
        "--stdio"
      ],
      "extensions": [
        ".md",
        ".txt",
        ".tex"
      ]
    }
  }
}
