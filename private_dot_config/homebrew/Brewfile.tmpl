{{- /* Keep package inventory in .chezmoidata; this file only renders it. */ -}}
{{- $taps := .packages.darwin.taps | sortAlpha | uniq -}}
{{- $formulae := concat .packages.common.tools .packages.darwin.formula | sortAlpha | uniq -}}
{{- $casks := .packages.darwin.casks | sortAlpha | uniq -}}
{{- $fonts := .packages.darwin.fonts | sortAlpha | uniq -}}

# This file is generated by chezmoi from .chezmoidata/{common,darwin}.toml.
# Edit those inventories rather than the rendered Brewfile.

# Taps
{{- range $taps }}
tap "{{ . }}"
{{- end }}

# Formulae
{{- range $formulae }}
brew "{{ . }}"
{{- end }}

# Casks
{{- range $casks }}
cask "{{ . }}"
{{- end }}

# Fonts
{{- range $fonts }}
cask "{{ . }}"
{{- end }}

# Mac App Store applications
{{- range $name, $id := .packages.darwin.mas }}
mas "{{ $name }}", id: {{ $id }}
{{- end }}
