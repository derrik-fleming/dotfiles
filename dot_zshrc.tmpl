# Keep this file usable on macOS, Linux, and machines without Homebrew.
typeset -U path cdpath fpath manpath

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export ZSH="$HOME/.oh-my-zsh"

path=(
  "$HOME/.local/bin"
  "$HOME/.pub-cache/bin"
  "$XDG_DATA_HOME/bob/nvim-bin"
  "$XDG_DATA_HOME/nvim/mason/bin"
  "$HOME/fvm/default/bin"
  $path
)

# Homebrew chooses its own prefix on Apple Silicon, Intel macOS, and Linux.
if (( $+commands[brew] )); then
  eval "$(brew shellenv)"
fi

plugins=(1password aws brew docker flutter gh git gitignore node yarn)
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  autoload -Uz compinit && compinit -C
  source "$ZSH/oh-my-zsh.sh"
fi

HISTSIZE=10000
SAVEHIST=10000
HISTFILE="$HOME/.zsh_history"
setopt HIST_FCNTL_LOCK HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY
unsetopt APPEND_HISTORY HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS HIST_FIND_NO_DUPS EXTENDED_HISTORY

function yy() {
  local tmp cwd
  tmp="$(mktemp -t yazi-cwd.XXXXXX)" || return
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(<"$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

(( $+commands[fzf] && $+options[zle] )) && source <(fzf --zsh)
[[ "$TERM" != dumb && $+commands[starship] -eq 1 ]] && eval "$(starship init zsh)"
(( $+commands[mise] )) && eval "$(mise activate zsh)"
(( $+commands[direnv] )) && eval "$(direnv hook zsh)"
(( $+commands[atuin] && $+options[zle] )) && eval "$(atuin init zsh)"
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

if [[ -n "${GHOSTTY_RESOURCES_DIR:-}" && -r "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration" ]]; then
  source "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration"
fi

(( $+commands[bat] )) && alias cat=bat
(( $+commands[zoxide] )) && alias cd=z
(( $+commands[lsd] )) && {
  alias la='lsd -A' ll='lsd -l' lla='lsd -lA' llt='lsd -l --tree' ls=lsd lt='lsd --tree'
}
alias d='fvm dart' f='fvm flutter' j=just ld=lazydocker vim=nvim zj=zellij

{{- if eq (dig "profile" "server" .) "workstation" }}
{{- if eq .chezmoi.os "darwin" }}
# 1Password's SSH agent is enabled only on trusted macOS workstations.
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}
{{- end }}

{{- if and (eq (dig "profile" "server" .) "workstation") (eq .chezmoi.os "darwin") }}
# These Ollama settings are for a trusted macOS workstation.
export OLLAMA_HOST=127.0.0.1:11434
export OLLAMA_KEEP_ALIVE=3600
export OLLAMA_NUM_PARALLEL=2
export OLLAMA_MAX_LOADED_MODELS=2
export OLLAMA_NUM_GPU=999
export OLLAMA_FLASH_ATTENTION=1
export OLLAMA_KV_CACHE_TYPE=q8_0
export OLLAMA_MAX_QUEUE=512
export OLLAMA_CONTEXT_LENGTH=32768
export MCPPROXY_DATA_DIR="$XDG_CONFIG_HOME/mcpproxy"
{{- end }}

export ANDROID_AVD_HOME="$XDG_CONFIG_HOME/.android/avd"
export OMO_SEND_ANONYMOUS_TELEMETRY=0
export OMO_DISABLE_POSTHOG=1
export OPENAI_BASE_URL=http://127.0.0.1:8787/v1
export LITELLM_LOCAL_MODEL_COST_MAP=true
export TF_BUILD=true
